rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Cars collection
    match /cars/{carId} {
      allow read, write: if true;
    }

    // Real estate collection (both real_estate and realestate for compatibility)
    match /real_estate/{propertyId} {
      allow read, write: if true;
    }
    match /realestate/{propertyId} {
      allow read, write: if true;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Owner Spotlight collection
    match /owner_spotlight/{adId} {
      allow read, write: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Activity Logs collection
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // FCM Notifications collection
    match /fcm_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
