  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.oms.syrianmarkets",
      "id": "com.oms.syrianmarkets"
    }
  ],
  "prefer_related_applications": false,
  "scope_extensions": [
    {
      "origin": "https://oms-markt.ai.studio"
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=import",
      "name": "OMS Market Files",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/?shared=true",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+oms",
      "url": "/?action=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/?tab=notes"
  },
  "widgets": [
    {
      "name": "أسعار الصرف اليوم",
      "short_name": "الصرف",
      "description": "أسعار الصرف والذهب اللحظية في سوريا",
      "tag": "currency-widget",
      "template": "currency-template",
      "ms_ac_template": "/widget.json",
      "data": "/widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "label": "ودجت أسعار الصرف"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
